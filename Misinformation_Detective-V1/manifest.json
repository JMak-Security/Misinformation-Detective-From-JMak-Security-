{
  "manifest_version": 3,
  "name": "Misinformation Detective",
  "version": "1.2",
  "description": "An autonomous and on-demand browser companion that cross-references online claims against live global data using decentralized AI.",
  
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://google.serper.dev/*",
    "https://openrouter.ai/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {},

  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}